<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <ApplicationIcon>Images\app-icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0" />
      <PackageReference Include="Dapper" Version="2.1.89" />
      <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.13" />
      <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.13" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
      <PackageReference Include="Npgsql" Version="10.0.3" />
        
      <PackageReference Include="Refit" Version="16.3.0" />
      <PackageReference Include="Refit.HttpClientFactory" Version="16.3.0" />
      <PackageReference Include="Refit.Reflection" Version="16.3.0" />
        
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Repositories\Dapper\" />
    </ItemGroup>

</Project>
